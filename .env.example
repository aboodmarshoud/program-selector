# GEMINI_API_KEY: server-side only. Never expose it as VITE_* or inject it into Vite define.
# Use it from an Express/API route if Gemini calls are added.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase analytics storage and private dashboard login.
# Keep the anon key public; analytics writes go through the track-analytics Edge Function.
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"
VITE_AUTH_REDIRECT_URL="https://aboodmarshoud.github.io/program-selector/?analytics=1"
VITE_ANALYTICS_OWNER_EMAIL="amarshoud2@gmail.com"

# Supabase Edge Function secret for track-analytics.
# Set this with: supabase secrets set ANALYTICS_FINGERPRINT_SALT="LONG_RANDOM_VALUE"
ANALYTICS_FINGERPRINT_SALT="LONG_RANDOM_VALUE"
